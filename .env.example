# Copy to .env.local for local development (default when APP_ENV=local).
# Production credentials live in Cloud Run environment variables, not in git.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dbuser
DB_NAME=communib
DB_PWD=your-local-postgres-password

# Contact form — messages go to CONTACT_INBOX_EMAIL (default: contactcommunib@gmail.com)
CONTACT_INBOX_EMAIL=contactcommunib@gmail.com
# Gmail SMTP (use an App Password: https://myaccount.google.com/apppasswords)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=contactcommunib@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=contactcommunib@gmail.com

# Optional: copy to .env.production and run with APP_ENV=production
# only when connecting to Cloud SQL from your machine (e.g. via Cloud SQL Auth Proxy).
# DB_HOST=your-cloud-sql-host
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=postgres
# DB_PWD=your-production-password

# Meeting AI — local dev only; production key lives in GCP Secret Manager (OPENAI_API_KEY)
# and is mounted on django-backend Cloud Run via scripts/wire-openai-prod.ps1 / deploy-prod.ps1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# PAID_AI_MODEL=gpt-4o
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
