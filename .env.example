# Copy to .env.local for local development (default when APP_ENV=local).
# Production credentials live in Cloud Run environment variables, not in git.

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=dbuser
DB_NAME=communib
DB_PWD=your-local-postgres-password

# Optional: copy to .env.production and run with APP_ENV=production
# only when connecting to Cloud SQL from your machine (e.g. via Cloud SQL Auth Proxy).
# DB_HOST=your-cloud-sql-host
# DB_PORT=5432
# DB_USER=postgres
# DB_NAME=postgres
# DB_PWD=your-production-password
