# Local dev: copy to .env.local (Vite loads it automatically in npm run dev).
VITE_API_URL=http://127.0.0.1:8000
VITE_APP_ENV=local

# Production Docker builds use VITE_API_URL / VITE_APP_ENV build args in frontend/Dockerfile.
# VITE_APP_ENV=production keeps the white production nav; local/dev shows a gray DEV banner.
