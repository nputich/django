{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "mobile:sync": "node scripts/build-mobile.mjs",
    "mobile:assets": "npx @capacitor/assets generate --iconBackgroundColor \"#276690\" --iconBackgroundColorDark \"#276690\" --splashBackgroundColor \"#ffffff\" --splashBackgroundColorDark \"#ffffff\" --assetPath resources",
    "mobile:android": "node scripts/build-mobile.mjs && npx cap open android",
    "mobile:ios": "node scripts/build-mobile.mjs && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/splash-screen": "^8.0.2",
    "axios": "^1.13.2",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.3",
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
